# Copy to .env for local development. These values ship to the browser —
# never put a secret in a REACT_APP_* variable.

# Base URL of the backend API (no trailing slash).
#
# Leave this UNSET in production. The Vercel deployment serves the API from
# /api on the same origin as the page, and an unset value resolves to exactly
# that — so there is nothing to update when the domain changes. Set it only if
# you host the API somewhere else, e.g. https://inventory-api.onrender.com
REACT_APP_API_URL=http://localhost:5000

# Smaller production bundles; set to true if you need to debug a build.
GENERATE_SOURCEMAP=false
