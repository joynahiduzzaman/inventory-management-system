# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Secrets ──────────────────────────────────────────────────────────────────
# Never commit real environment values. Commit only *.env.example files.
.env
.env.*
!.env.example
!**/.env.example

# ── Build output ─────────────────────────────────────────────────────────────
build/
dist/
.next/
out/

# ── Runtime / user data ──────────────────────────────────────────────────────
# Uploaded product images are runtime data, not source.
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Tooling caches ───────────────────────────────────────────────────────────
.eslintcache
coverage/
.vercel
.turbo

# ── Scratch files ────────────────────────────────────────────────────────────
_patch*.py
_apitest*.js
_inspect.js
_cleanup.js
*.local
