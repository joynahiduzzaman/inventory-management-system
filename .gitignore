# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Secrets ──────────────────────────────────────────────────────────────────
# Never commit real environment values. Commit only *.env.example files.
.env
.env.*
!.env.example
!**/.env.example

# ── Build output ─────────────────────────────────────────────────────────────
build/
dist/
.next/
out/

# ── Runtime / user data ──────────────────────────────────────────────────────
# Uploaded product images are runtime data, not source.
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Tooling caches ───────────────────────────────────────────────────────────
.eslintcache
coverage/
.vercel
.turbo

# ── Scratch files ────────────────────────────────────────────────────────────
_patch*.py
_apitest*.js
_inspect.js
_cleanup.js
*.local

# ── Vercel CLI ───────────────────────────────────────────────────────────────
.vercel
# Appended by `vercel link`. It is deliberately broad, so the .env.example
# negations are restated below it — otherwise the one env file that SHOULD be
# committed silently stops being tracked in a fresh clone.
.env*
!.env.example
!**/.env.example

# ── Database backups ─────────────────────────────────────────────────────────
# Written by `npm run migrate:prod` before it copies anything. Full table dumps,
# including password hashes — never commit them.
backend/backups/
