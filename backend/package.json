{
  "name": "inventory-backend",
  "version": "2.0.0",
  "description": "Inventory Management System Backend — Production Ready",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/validate.test.js",
    "test:api": "node tests/api.test.js",
    "seed:demo": "node scripts/seedDemo.js",
    "seed:demo:reset": "node scripts/seedDemo.js --reset",
    "db:fix-indexes": "node scripts/fixIndexes.js",
    "migrate:prod": "node scripts/migrateToProduction.js",
    "images:cloudinary": "node scripts/imagesToCloudinary.js",
    "images:cloudinary:dry": "node scripts/imagesToCloudinary.js --dry-run",
    "migrate:check": "node scripts/migrateToProduction.js --check"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.35.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18"
  }
