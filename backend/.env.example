# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# On Vercel these are set in Project → Settings → Environment Variables
# instead of in a file. See DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Either set DATABASE_URL (managed providers usually give you one)…
# DATABASE_URL=mysql://user:password@host:3306/dbname
# …or the discrete variables below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=inventory_db

# Managed MySQL almost always requires TLS. Leave false for local MySQL.
DB_SSL=false
# Optional: PEM contents of the provider's CA, to enable certificate verification.
# DB_CA_CERT=

# Max pooled connections. Every warm serverless instance holds a pool of its
# own, so the number that matters against a free tier's cap is
# (instances x DB_POOL_MAX). Defaults to 3 in production, 10 locally.
# DB_POOL_MAX=3
# DB_LOGGING=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to start otherwise.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# ── First-run admin ──────────────────────────────────────────────────────────
# Used only while the users table is empty, and only by server.js / the seed
# scripts. Password must be 8+ characters.
SEED_ADMIN_EMAIL=admin@shop.com
SEED_ADMIN_PASSWORD=change_me_min_8_chars
SEED_STAFF_EMAIL=staff@shop.com
SEED_STAFF_PASSWORD=change_me_min_8_chars

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Only needed when the API is hosted separately from the frontend. In the
# single-Vercel-project setup they share an origin, which is always allowed.
FRONTEND_URL=http://localhost:3000
# Allow *.vercel.app preview deployments through CORS (production deploys only).
ALLOW_VERCEL_PREVIEWS=false

# ── Hosting ──────────────────────────────────────────────────────────────────
# Set to 1 behind a load balancer (Render, Railway, Fly) so client IPs and
# rate limiting work correctly. Leave unset when running directly; Vercel is
# detected automatically.
# TRUST_PROXY=1

# This API's own public origin, so uploaded images satisfy the CSP img-src rule.
# Not needed when the API and frontend share an origin.
# PUBLIC_API_URL=https://your-app.vercel.app

# ── Product images (Cloudinary) ──────────────────────────────────────────────
# One variable, from your Cloudinary dashboard. With it set, uploads go to
# Cloudinary and are served from its CDN — the database stores only the URL,
# and no image request ever reaches the API.
#
# Leave it unset and images fall back to the `product_images` table instead, so
# a fresh clone and the test suite work with no external account.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=inventory-products

# Only affects reading images written by the oldest releases, which saved them
# to local disk.
# UPLOAD_DIR=/var/data/uploads

# ── Migration target (scripts/migrateToProduction.js only) ───────────────────
# Where `npm run migrate:prod` creates the schema and copies data TO. Set these
# only while running that command — never in a deployed environment.
# TARGET_DATABASE_URL=mysql://user:password@host:3306/dbname
# TARGET_DB_HOST=
# TARGET_DB_PORT=3306
# TARGET_DB_USER=
# TARGET_DB_PASSWORD=
# TARGET_DB_NAME=
# TARGET_DB_SSL=            # "false" only for a plain local target; TLS is on by default
# TARGET_DB_CA_CERT=
