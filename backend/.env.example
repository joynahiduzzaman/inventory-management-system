# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Either set DATABASE_URL (managed providers usually give you one)…
# DATABASE_URL=mysql://user:password@host:3306/dbname
# …or the discrete variables below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=inventory_db

# Managed MySQL almost always requires TLS. Leave false for local MySQL.
DB_SSL=false
# Optional: PEM contents of the provider's CA, to enable certificate verification.
# DB_CA_CERT=

# Max pooled connections. Keep low on free managed tiers.
# DB_POOL_MAX=5
# DB_LOGGING=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to start otherwise.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# ── First-run admin ──────────────────────────────────────────────────────────
# Used only while the users table is empty. Password must be 8+ characters.
SEED_ADMIN_EMAIL=admin@shop.com
SEED_ADMIN_PASSWORD=change_me_min_8_chars
SEED_STAFF_EMAIL=staff@shop.com
SEED_STAFF_PASSWORD=change_me_min_8_chars

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3000
# Allow *.vercel.app preview deployments through CORS (production deploys only).
ALLOW_VERCEL_PREVIEWS=false

# ── Hosting ──────────────────────────────────────────────────────────────────
# Set to 1 behind a load balancer (Render, Railway, Fly) so client IPs and
# rate limiting work correctly. Leave unset when running directly.
# TRUST_PROXY=1

# This API's own public origin, so uploaded images satisfy the CSP img-src rule.
# PUBLIC_API_URL=https://your-api.onrender.com

# Where uploaded product images are written. Point at a mounted persistent
# disk in production, otherwise images are lost on redeploy.
# UPLOAD_DIR=/var/data/uploads
