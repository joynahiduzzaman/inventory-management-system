{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd backend && npm ci --omit=dev && cd ../frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/build",
  "framework": "create-react-app",
  "//regions": "The database is TiDB Serverless in ap-southeast-1 (Singapore). Functions defaulted to iad1 (US East), so every query crossed the Pacific twice — measured 4.0s on the dashboard and 3.4s on the integrity scan, warm, at 245 sales. Pinning sin1 puts the code next to the data it reads, and next to the shop.",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{backend/fonts/**,backend/node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__vpath=api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api?__vpath=api/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|static/|favicon\\.svg|manifest\\.json|robots\\.txt|asset-manifest\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), payment=(), camera=(self)"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
